@startuml 05-dynamic-generate
!include <C4/C4_Dynamic>
title Dynamic: npm run generate (write, render, fit, revise)
LAYOUT_LEFT_RIGHT()

Person(author, "Content author")
System_Ext(claudeApi, "Claude API", "Messages API")
Container_Ext(chrome, "Headless Chrome", "Puppeteer")
ContainerDb_Ext(io, "output/", "Files")

Container_Boundary(cliBoundary, "Generator CLI") {
  Component(cli, "cli.js", "Entry point")
  Component(pipeline, "pipeline.js", "Orchestrator")
  Component(loaders, "Sidecar loaders", "templates, brand, examples")
  Component(agent, "OnePagerAgent", "@anthropic-ai/sdk")
  Component(render, "html.js + pdf.js", "Handlebars + PdfRenderer")
}

Rel(author, cli, "generate source.pdf --template auto")
Rel(cli, pipeline, "generateOnePager()")
Rel(pipeline, loaders, "Load brand.json, example.json, template.json")
Rel(pipeline, agent, "selectTemplate()")
Rel(agent, claudeApi, "Pick a layout (effort low, enum schema)")
Rel(pipeline, agent, "writeContent()")
Rel(agent, claudeApi, "Brand + examples (cached) + PDF + sidecar; structured output")
Rel(agent, render, "evaluate(content): HTML, then PDF")
Rel(render, chrome, "Measure each page with .fit-measure; print PDF")
Rel(agent, claudeApi, "On overflow: describeFit() feedback, revise (max 3 attempts)")
Rel(pipeline, io, "Write .pdf, .html and .content.json sidecar")

SHOW_LEGEND()
@enduml
