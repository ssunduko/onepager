# Onepager environment variables.
# Copy to .env (git-ignored) and fill in what you need:  cp .env.example .env
# src/core/config.js loads .env automatically; variables already set in your shell take precedence.
# Only `npm run generate` calls the Claude API. render, validate and templates need nothing here.

# --- Claude API credentials -------------------------------------------------
# Leave commented out if you use `ant auth login` (an OAuth profile) or another credential source:
# an empty ANTHROPIC_API_KEY= line would shadow them.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: route requests through a proxy or gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Onepager settings -------------------------------------------------------
# Model used for template selection and content writing (default: claude-opus-5).
ONEPAGER_MODEL=claude-opus-5

# Server-side refusal fallbacks: "on" (default) or "off".
# Set to "off" on Amazon Bedrock, Google Vertex AI or Microsoft Foundry, which don't support them.
ONEPAGER_FALLBACKS=on

# --- Rendering ----------------------------------------------------------------
# Optional: use an installed Chrome/Chromium instead of the one Puppeteer downloaded.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
