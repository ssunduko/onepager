{
  "permissions": {
    "allow": [
      "Bash(npm run templates)",
      "Bash(npm run templates:*)",
      "Bash(npm run validate:*)",
      "Bash(npm run render:*)",
      "Read(./brand/**)",
      "Read(./examples/**)",
      "Read(./templates/**)",
      "Read(./input/**)",
      "Read(./output/**)",
      "Write(./output/**)",
      "Edit(./output/**)",
      "Bash(node .claude/skills/import-figma-example/find-frames.mjs:*)",
      "Write(./examples/**)",
      "mcp__claude_ai_Figma__get_metadata",
      "mcp__claude_ai_Figma__get_screenshot",
      "mcp__claude_ai_Figma__get_design_context",
      "mcp__claude_ai_Figma__get_variable_defs",
      "Bash(bash scripts/cloud-setup.sh)",
      "Bash(node scripts/check-chrome.mjs)",
      "Bash(bash scripts/publish-deliverable.sh:*)"
    ],
    "ask": [
      "Bash(npm run generate:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/cloud-setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
