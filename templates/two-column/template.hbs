{{#each content.pages}}
<main class="page{{#if @first}} first{{/if}}">
  {{#if @first}}
  {{> brandHeader @root}}
  <div class="headline-band">
    <h1>{{@root.content.title}}{{#if @root.content.title_accent}} <span class="accent">{{@root.content.title_accent}}</span>{{/if}}</h1>
    {{#if @root.content.summary}}<p class="lede">{{@root.content.summary}}</p>{{/if}}
  </div>
  {{else}}
  <header class="running-header">
    <img src="{{@root.logos.primary}}" alt="{{@root.brand.name}}">
    <span>{{@root.content.title}}{{#if @root.content.title_accent}} {{@root.content.title_accent}}{{/if}}</span>
  </header>
  {{/if}}

  <div class="columns">
    <div class="main">
      {{#each sections}}
      <section>
        <h2>{{heading}}</h2>
        {{#if body}}<p>{{body}}</p>{{/if}}
        {{> bulletList bullets}}
        {{#if (hasItems rows)}}
        <dl class="rows">
          {{#each rows}}<div class="row"><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
        </dl>
        {{/if}}
      </section>
      {{/each}}
    </div>

    {{#with sidebar}}
    <aside class="sidebar">
      {{#if (hasItems facts)}}
      <div class="facts">
        {{#if heading}}<h3>{{heading}}</h3>{{/if}}
        <dl>
          {{#each facts}}
          <div class="fact"><dt>{{label}}</dt><dd>{{value}}</dd></div>
          {{/each}}
        </dl>
      </div>
      {{else}}{{#if heading}}<h3 class="sidebar-heading">{{heading}}</h3>{{/if}}
      {{/if}}
      {{#if callout_title}}{{> infoCallout title=callout_title text=callout_text}}{{/if}}
      {{#if quote}}
      <figure class="quote">
        <blockquote>“{{quote}}”</blockquote>
        {{#if quote_author}}<figcaption><strong>{{quote_author}}</strong>{{#if quote_role}}<br>{{quote_role}}{{/if}}</figcaption>{{/if}}
      </figure>
      {{/if}}
    </aside>
    {{/with}}
  </div>

  <div class="spacer"></div>
  {{#if @last}}{{#if @root.content.cta.headline}}{{> cta @root}}{{/if}}{{/if}}
  {{> brandFooter page=(inc @index) pages=@root.content.pages.length}}
</main>
{{/each}}
