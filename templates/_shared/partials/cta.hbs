{{#with content.cta}}
<section class="cta">
  <div>
    <h2>{{headline}}</h2>
    {{#if text}}<p>{{text}}</p>{{/if}}
  </div>
  <div>
    {{#with (safeUrl url @root.brand.website) as |href|}}
    <a class="button" href="{{href}}">{{../button_label}}</a>
    <span class="url">{{bareUrl href}}</span>
    {{else}}
    <span class="button">{{button_label}}</span>
    {{/with}}
  </div>
</section>
{{/with}}
