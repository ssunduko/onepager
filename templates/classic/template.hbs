{{#each content.pages}}
<main class="page{{#if @first}} first{{/if}}">
  {{#if @first}}
  <div class="hero hero-band">
    {{> brandHeader @root noEyebrow=true}}
    <div class="hero-copy">
      {{#if @root.content.eyebrow}}<span class="pill">{{@root.content.eyebrow}}</span>{{/if}}
      <h1>{{@root.content.title}}{{#if @root.content.title_accent}} <span class="accent">{{@root.content.title_accent}}</span>{{/if}}</h1>
      {{#if @root.content.subtitle}}<p class="subtitle">{{@root.content.subtitle}}</p>{{/if}}
      {{#if @root.content.intro}}<p class="lede">{{@root.content.intro}}</p>{{/if}}
    </div>
  </div>
  {{else}}
  <header class="running-header">
    <img src="{{@root.logos.primary}}" alt="{{@root.brand.name}}">
    <span>{{@root.content.title}}{{#if @root.content.title_accent}} {{@root.content.title_accent}}{{/if}}</span>
  </header>
  {{/if}}

  <div class="sections">
    {{#each sections}}
    <section class="section">
      <span class="index"></span>
      <div>
        <h2>{{heading}}</h2>
        {{#if body}}<p>{{body}}</p>{{/if}}
        {{> bulletList bullets}}
        {{#if (hasItems rows)}}
        <dl class="rows">
          {{#each rows}}<div class="row"><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
        </dl>
        {{/if}}
      </div>
    </section>
    {{/each}}
  </div>

  <div class="spacer"></div>
  {{#if @last}}{{#if @root.content.cta.headline}}{{> cta @root}}{{/if}}{{/if}}
  {{> brandFooter page=(inc @index) pages=@root.content.pages.length}}
</main>
{{/each}}
