{{#each content.pages}}
<main class="page">
  <header class="guide-hero hero-band">
    <div class="topbar">
      <img class="logo" src="{{@root.logos.primary}}" alt="{{@root.brand.name}}">
      {{#if @root.content.date_label}}<span class="date">{{@root.content.date_label}}</span>{{/if}}
    </div>
    <div class="hero-copy">
      {{#if @root.content.eyebrow}}<span class="pill">{{@root.content.eyebrow}}</span>{{/if}}
      <h1>{{title}}{{#if title_accent}} <span class="accent">{{title_accent}}</span>{{/if}}</h1>
      {{#if subtitle}}<p class="subtitle">{{subtitle}}</p>{{/if}}
    </div>
  </header>

  <div class="guide-body">
    {{#each blocks}}
    {{#if (eq type "highlight")}}
    <section class="block highlight">
      <p class="statement">{{statement}}</p>
      {{#if note}}<p class="note">{{note}}</p>{{/if}}
    </section>
    {{/if}}

    {{#if (eq type "callout")}}
    {{> infoCallout class="block"}}
    {{/if}}

    {{#if (eq type "definitions")}}
    <section class="block definitions{{#if striped}} striped{{/if}}">
      {{#if heading}}<h2>{{heading}}</h2>{{/if}}
      {{#if intro}}<p class="intro">{{intro}}</p>{{/if}}
      <dl>
        {{#each rows}}<div class="row"><dt>{{term}}</dt><dd>{{definition}}</dd></div>{{/each}}
      </dl>
    </section>
    {{/if}}

    {{#if (eq type "stat_cards")}}
    <section class="block stat-cards">
      {{#if heading}}<h2>{{heading}}</h2>{{/if}}
      {{#if intro}}<p class="intro">{{intro}}</p>{{/if}}
      <div class="cards">
        {{#each cards}}
        <div class="card">
          {{#if label}}<p class="label">{{label}}</p>{{/if}}
          <p class="value">{{value}}</p>
          {{#if caption}}<p class="caption">{{caption}}</p>{{/if}}
          {{#if (hasItems points)}}<ul class="points">{{#each points}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
        </div>
        {{/each}}
      </div>
      {{#if footnote}}<p class="footnote">{{footnote}}</p>{{/if}}
    </section>
    {{/if}}

    {{#if (eq type "example_cards")}}
    <section class="block example-cards">
      {{#if heading}}<h2>{{heading}}</h2>{{/if}}
      <div class="grid{{#if (eq cards.length 2)}} two{{/if}}{{#if (eq cards.length 4)}} two{{/if}}">
        {{#each cards}}
        <div class="card"><p class="title">{{title}}</p><p class="detail">{{detail}}</p><p class="value">{{value}}</p></div>
        {{/each}}
      </div>
      {{#if footnote}}<p class="footnote">{{footnote}}</p>{{/if}}
    </section>
    {{/if}}

    {{#if (eq type "table")}}
    <section class="block table{{#if columns.note}} has-note{{/if}}{{#each rows}}{{#if note}} has-note{{/if}}{{/each}}">
      {{#if heading}}<h2>{{heading}}</h2>{{/if}}
      {{#if columns.label}}
      <header class="thead"><span>{{columns.label}}</span><span>{{columns.value}}</span><span>{{columns.note}}</span></header>
      {{/if}}
      {{#each rows}}
      <div class="tr"><span class="label">{{label}}</span><span class="value">{{value}}</span><span class="note">{{note}}</span></div>
      {{/each}}
    </section>
    {{/if}}

    {{#if (eq type "faq")}}
    <section class="block faq">
      {{#if heading}}<h2>{{heading}}</h2>{{/if}}
      {{#each items}}<div class="qa"><h3>{{question}}</h3><p>{{answer}}</p></div>{{/each}}
    </section>
    {{/if}}

    {{#if (eq type "text")}}
    <section class="block text">
      {{#if heading}}<h2>{{heading}}</h2>{{/if}}
      {{#each paragraphs}}<p>{{#if lead}}<strong>{{lead}}</strong> {{/if}}{{text}}</p>{{/each}}
    </section>
    {{/if}}
    {{/each}}
  </div>

  <div class="spacer"></div>
  {{> brandFooter page=(inc @index) pages=@root.content.pages.length}}
</main>
{{/each}}
