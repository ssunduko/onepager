{
  "id": "customer-guide",
  "name": "Customer Guide",
  "version": "2.0.0",
  "description": "A4 help-style guide from the Salesmessage Figma design system, 1-5 pages. Every page repeats the header (logo, guide label, date) and has its own light-blue gradient hero with a numbered eyebrow (\"02 / TOPIC\"), a two-line headline and a subtitle, followed by typed content blocks (highlight, callout, definitions, stat cards, example cards, tables, FAQ, rich paragraphs). Footer with website, support email and page number. No sales CTA.",
  "bestFor": "Customer-facing explainers, onboarding guides, how-to and reference material, pricing/rates or billing explanations, FAQs: anything that teaches an existing customer rather than sells. Each page covers one topic, like chapters of the Figma SMS Credit Calculation Guide.",
  "source": "https://www.figma.com/design/J12oSQR4pnHEixxXlXhvLC/Marketing-Working-File?node-id=2811-6043",
  "entry": "template.hbs",
  "styles": [
    "styles.css"
  ],
  "page": {
    "format": "A4",
    "landscape": false,
    "maxPages": 5
  },
  "guidance": [
    "Match examples/figma-sms-credit-guide (a 5-page document in exactly this template): plain, practical, second person; every page is a self-contained chapter with its own takeaway headline.",
    "Use as many pages as the content honestly needs (max 5). Add a page rather than cutting facts a reader would miss, but never pad. Every page should be well filled: free space at the bottom at most ~20% (render reports it per page).",
    "eyebrow: the guide topic in 2-5 words; it is shown on every page, numbered automatically when there is more than one page. Per page, title: 4-7 words, reads well over two lines; subtitle: one sentence, at most 16 words.",
    "Per page: 2-4 blocks, ordered from most to least important, about 180-260 words.",
    "highlight: one big equation-style takeaway; at most once per page, usually first.",
    "callout: one caveat or tip, title at most 7 words, text at most 35 words.",
    "definitions: 3-6 rows; term at most 4 words, definition at most 16 words. striped=true for a glossary, false for policy-style rows.",
    "stat_cards: 2 or 3 cards; value is short; use tone green only for the contrasting second case in a two-card comparison.",
    "example_cards: 4 or 6 cards (2-column grid); title at most 5 words, detail at most 6 words, value at most 3 words.",
    "table: 3-10 rows. Fill columns.note and every row.note for a 3-column table, or leave all notes empty for a 2-column table.",
    "faq: 3-5 questions, answers at most 22 words.",
    "text: 1-3 paragraphs; lead is an optional bold lead-in of 2-5 words; text at most 40 words each.",
    "Every value, number and rate must come from the source document."
  ],
  "contentSchema": {
    "type": "object",
    "properties": {
      "header_label": {
        "type": "string",
        "description": "Top-right label, e.g. \"Customer guide\", 1-3 words."
      },
      "date_label": {
        "type": "string",
        "description": "Month and year from the source, e.g. \"September 2026\", or empty."
      },
      "eyebrow": {
        "type": "string",
        "description": "Guide topic, 2-5 words; numbered per page automatically."
      },
      "pages": {
        "type": "array",
        "description": "1-5 pages in reading order; each is a chapter with its own hero.",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Page headline, 4-7 words."
            },
            "subtitle": {
              "type": "string",
              "description": "One sentence, at most 16 words."
            },
            "blocks": {
              "type": "array",
              "description": "2-4 content blocks in reading order.",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "description": "Big one-line takeaway banner.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "highlight"
                        ]
                      },
                      "statement": {
                        "type": "string",
                        "description": "Left side, e.g. \"1 SMS segment\"."
                      },
                      "result": {
                        "type": "string",
                        "description": "Right side in accent color, e.g. \"= 1 credit\"."
                      },
                      "note": {
                        "type": "string",
                        "description": "Small line underneath, at most 10 words, or empty."
                      }
                    },
                    "required": [
                      "type",
                      "statement",
                      "result",
                      "note"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Tinted box with a blue left bar for one caveat or tip.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "callout"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "description": "At most 7 words."
                      },
                      "text": {
                        "type": "string",
                        "description": "At most 35 words."
                      }
                    },
                    "required": [
                      "type",
                      "title",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Term / explanation rows.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "definitions"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "intro": {
                        "type": "string",
                        "description": "At most 35 words, or empty."
                      },
                      "striped": {
                        "type": "boolean",
                        "description": "true = zebra rows (glossary); false = plain rows."
                      },
                      "rows": {
                        "type": "array",
                        "description": "3-6 rows.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "term": {
                              "type": "string",
                              "description": "At most 4 words."
                            },
                            "definition": {
                              "type": "string",
                              "description": "At most 16 words."
                            }
                          },
                          "required": [
                            "term",
                            "definition"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "intro",
                      "striped",
                      "rows"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "2-3 side-by-side cards with one large value each.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "stat_cards"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "intro": {
                        "type": "string",
                        "description": "At most 30 words, or empty."
                      },
                      "cards": {
                        "type": "array",
                        "description": "2 or 3 cards.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "description": "Small bold label above the value, at most 6 words, or empty."
                            },
                            "value": {
                              "type": "string",
                              "description": "Large value, e.g. \"160\" or \"3 credits / min\"."
                            },
                            "caption": {
                              "type": "string",
                              "description": "Line under the value, at most 8 words."
                            },
                            "note": {
                              "type": "string",
                              "description": "Muted footnote, at most 8 words, or empty."
                            },
                            "tone": {
                              "type": "string",
                              "enum": [
                                "blue",
                                "green"
                              ]
                            }
                          },
                          "required": [
                            "label",
                            "value",
                            "caption",
                            "note",
                            "tone"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "footnote": {
                        "type": "string",
                        "description": "Paragraph under the cards, at most 30 words, or empty."
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "intro",
                      "cards",
                      "footnote"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "2-column grid of small worked-example cards.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "example_cards"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading."
                      },
                      "cards": {
                        "type": "array",
                        "description": "4 or 6 cards.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "description": "At most 5 words."
                            },
                            "detail": {
                              "type": "string",
                              "description": "At most 6 words."
                            },
                            "value": {
                              "type": "string",
                              "description": "At most 3 words, e.g. \"3 credits\"."
                            }
                          },
                          "required": [
                            "title",
                            "detail",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "cards"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Striped table with a bold blue value column and an optional note column.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "table"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "columns": {
                        "type": "object",
                        "description": "Column headers; all empty hides the header row.",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          },
                          "note": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "label",
                          "value",
                          "note"
                        ],
                        "additionalProperties": false
                      },
                      "rows": {
                        "type": "array",
                        "description": "3-10 rows.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "description": "At most 5 words."
                            },
                            "value": {
                              "type": "string",
                              "description": "At most 4 words, shown in bold accent."
                            },
                            "note": {
                              "type": "string",
                              "description": "At most 14 words, or empty for a 2-column table."
                            }
                          },
                          "required": [
                            "label",
                            "value",
                            "note"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "columns",
                      "rows"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Question and answer list.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "faq"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "e.g. \"Quick answers\"."
                      },
                      "items": {
                        "type": "array",
                        "description": "3-5 items.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "question": {
                              "type": "string",
                              "description": "At most 10 words."
                            },
                            "answer": {
                              "type": "string",
                              "description": "At most 22 words."
                            }
                          },
                          "required": [
                            "question",
                            "answer"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "items"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Heading plus paragraphs with optional bold lead-ins.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "text"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "paragraphs": {
                        "type": "array",
                        "description": "1-3 paragraphs.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "lead": {
                              "type": "string",
                              "description": "Bold lead-in, 2-5 words, or empty."
                            },
                            "text": {
                              "type": "string",
                              "description": "At most 40 words."
                            }
                          },
                          "required": [
                            "lead",
                            "text"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "paragraphs"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "title",
            "subtitle",
            "blocks"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "header_label",
      "date_label",
      "eyebrow",
      "pages"
    ],
    "additionalProperties": false
  }
}
