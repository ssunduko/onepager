{
  "id": "customer-guide",
  "name": "Customer Guide",
  "version": "3.0.0",
  "description": "A4 help-style guide from the Salesmessage Figma design system, 1-5 pages. Every page opens with a light-blue hero band (logo, date, a pill-shaped topic label, a two-tone headline with the last words in blue, and a subtitle), followed by typed content blocks (highlight, info callout, definitions, stat cards, example cards, tables, FAQ, rich paragraphs). Footer with logo, website / phone, social icons and page number. No sales CTA.",
  "bestFor": "Customer-facing explainers, onboarding guides, how-to and reference material, pricing/rates or billing explanations, FAQs: anything that teaches an existing customer rather than sells. Each page covers one topic, like chapters of the Figma SMS Credit Calculation Guide.",
  "source": "https://www.figma.com/design/XMCP0ExsAQKFku0OWqgjiv/One-Pagers?node-id=14170-4637",
  "entry": "template.hbs",
  "styles": [
    "styles.css"
  ],
  "page": {
    "format": "A4",
    "landscape": false,
    "maxPages": 5
  },
  "guidance": [
    "Match examples/figma-sms-credit-guide (a 5-page document in exactly this template): plain, practical, second person; every page is a self-contained chapter with its own takeaway headline.",
    "Use as many pages as the content honestly needs (max 5). Add a page rather than cutting facts a reader would miss, but never pad. Every page should be well filled: free space at the bottom at most ~20% (render reports it per page).",
    "eyebrow: the guide topic in 2-5 words, shown as a pill on every page. Per page, title + title_accent together are 3-6 words and fit on one line (about 32 characters); title_accent is the 1-3 word ending shown in blue (\"How Salesmsg\" + \"credits work\"). subtitle: one sentence, at most 14 words.",
    "Per page: 2-4 blocks, ordered from most to least important, about 150-230 words.",
    "highlight: one centered equation-style takeaway (\"1 SMS segment = 1 credit\"); at most once per page, usually first.",
    "callout: one caveat or tip with an info icon, title at most 7 words, text at most 32 words. Often closes a page.",
    "definitions: 3-6 rows; term at most 3 words, definition at most 16 words. striped=true for a glossary or policy rows (the Figma default).",
    "stat_cards: 2 or 3 cards. value is the big blue equation (\"160 characters = 1 credit\", \"1 credit = 1 min\"), at most 26 characters for 2 cards and 16 for 3. Use label + caption, or 2 short points instead.",
    "example_cards: 2, 3, 4 or 6 cards (3 per row; 2 per row for 2 or 4 cards); title at most 5 words, detail at most 6 words, value at most 3 words.",
    "table: 3-11 rows. Fill columns and every row.note for a 3-column reference table, or leave columns and notes empty for a 2-column label/value table.",
    "faq: 3-5 questions, answers at most 22 words.",
    "text: 1-3 paragraphs; lead is an optional bold lead-in of 2-5 words; text at most 50 words each.",
    "Every value, number and rate must come from the source document."
  ],
  "contentSchema": {
    "type": "object",
    "properties": {
      "date_label": {
        "type": "string",
        "description": "Month and year from the source, e.g. \"September 2026\", or empty."
      },
      "eyebrow": {
        "type": "string",
        "description": "Guide topic for the hero pill, 2-5 words."
      },
      "pages": {
        "type": "array",
        "description": "1-5 pages in reading order; each is a chapter with its own hero.",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Headline start in ink; with title_accent 3-6 words."
            },
            "title_accent": {
              "type": "string",
              "description": "Last 1-3 words of the headline, shown in blue, or empty."
            },
            "subtitle": {
              "type": "string",
              "description": "One sentence, at most 14 words."
            },
            "blocks": {
              "type": "array",
              "description": "2-4 content blocks in reading order.",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "description": "Centered one-line takeaway in blue on a panel.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "highlight"
                        ]
                      },
                      "statement": {
                        "type": "string",
                        "description": "Equation-style takeaway, e.g. \"1 SMS segment = 1 credit\", at most 30 characters."
                      },
                      "note": {
                        "type": "string",
                        "description": "Small line underneath, at most 10 words, or empty."
                      }
                    },
                    "required": [
                      "type",
                      "statement",
                      "note"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Info-icon callout panel for one caveat or tip.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "callout"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "description": "At most 7 words."
                      },
                      "text": {
                        "type": "string",
                        "description": "At most 32 words."
                      }
                    },
                    "required": [
                      "type",
                      "title",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Term / explanation rows.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "definitions"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "intro": {
                        "type": "string",
                        "description": "At most 35 words, or empty."
                      },
                      "striped": {
                        "type": "boolean",
                        "description": "true = zebra rows (glossary); false = plain rows."
                      },
                      "rows": {
                        "type": "array",
                        "description": "3-6 rows.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "term": {
                              "type": "string",
                              "description": "At most 4 words."
                            },
                            "definition": {
                              "type": "string",
                              "description": "At most 16 words."
                            }
                          },
                          "required": [
                            "term",
                            "definition"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "intro",
                      "striped",
                      "rows"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "2-3 side-by-side cards, each with one big blue value.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "stat_cards"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "intro": {
                        "type": "string",
                        "description": "At most 30 words, or empty."
                      },
                      "cards": {
                        "type": "array",
                        "description": "2 or 3 cards.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "description": "Semibold line above the value, at most 6 words, or empty."
                            },
                            "value": {
                              "type": "string",
                              "description": "Big blue value, e.g. \"160 characters = 1 credit\"."
                            },
                            "caption": {
                              "type": "string",
                              "description": "Line under the value, at most 8 words, or empty."
                            },
                            "points": {
                              "type": "array",
                              "description": "0-3 short bullet points under the value, at most 5 words each.",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "label",
                            "value",
                            "caption",
                            "points"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "footnote": {
                        "type": "string",
                        "description": "Paragraph under the cards, at most 30 words, or empty."
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "intro",
                      "cards",
                      "footnote"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Grid of small worked-example cards (3 per row; 2 per row for 2 or 4 cards).",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "example_cards"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading."
                      },
                      "cards": {
                        "type": "array",
                        "description": "2, 3, 4 or 6 cards.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "description": "At most 5 words."
                            },
                            "detail": {
                              "type": "string",
                              "description": "At most 6 words."
                            },
                            "value": {
                              "type": "string",
                              "description": "At most 3 words, e.g. \"3 credits\"."
                            }
                          },
                          "required": [
                            "title",
                            "detail",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "footnote": {
                        "type": "string",
                        "description": "Paragraph under the cards, at most 30 words, or empty."
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "cards",
                      "footnote"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Striped table with a blue header row and an optional note column.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "table"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "columns": {
                        "type": "object",
                        "description": "Column headers; all empty hides the header row.",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          },
                          "note": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "label",
                          "value",
                          "note"
                        ],
                        "additionalProperties": false
                      },
                      "rows": {
                        "type": "array",
                        "description": "3-11 rows.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "description": "At most 6 words."
                            },
                            "value": {
                              "type": "string",
                              "description": "At most 4 words, shown semibold."
                            },
                            "note": {
                              "type": "string",
                              "description": "At most 14 words, or empty for a 2-column table."
                            }
                          },
                          "required": [
                            "label",
                            "value",
                            "note"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "columns",
                      "rows"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Question and answer list.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "faq"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "e.g. \"Quick answers\"."
                      },
                      "items": {
                        "type": "array",
                        "description": "3-5 items.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "question": {
                              "type": "string",
                              "description": "At most 10 words."
                            },
                            "answer": {
                              "type": "string",
                              "description": "At most 22 words."
                            }
                          },
                          "required": [
                            "question",
                            "answer"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "items"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "description": "Heading plus paragraphs with optional bold lead-ins.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "text"
                        ]
                      },
                      "heading": {
                        "type": "string",
                        "description": "Section heading, or empty."
                      },
                      "paragraphs": {
                        "type": "array",
                        "description": "1-3 paragraphs.",
                        "items": {
                          "type": "object",
                          "properties": {
                            "lead": {
                              "type": "string",
                              "description": "Bold lead-in, 2-5 words, or empty."
                            },
                            "text": {
                              "type": "string",
                              "description": "At most 50 words."
                            }
                          },
                          "required": [
                            "lead",
                            "text"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "type",
                      "heading",
                      "paragraphs"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "title",
            "title_accent",
            "subtitle",
            "blocks"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "date_label",
      "eyebrow",
      "pages"
    ],
    "additionalProperties": false
  }
}
